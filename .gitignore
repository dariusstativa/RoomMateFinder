###############################################
#          OPTIONAL MASSIVE OPTIMIZERS         #
###############################################

# Unreal / Unity accidental folders (if someone messes up)
Library/
Temp/
Cache/
obj*/          # fallback
Logs/

# Python cache if someone mixes projects
__pycache__/
*.pyc

###############################################
#            GIT INTERNAL SANITY               #
###############################################

# Prevent accidental nested repos from being committed
*/.git/

