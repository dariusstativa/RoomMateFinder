@using RoomMateFinder.Client.Models
@inject HttpClient Http
@inject RoomMateFinder.Client.Services.AuthService AuthService
@inject NavigationManager Navigation

<div class="review-summary-card">
    <div class="summary-left">
        <span class="star">⭐</span>
        <span class="average">@Average.ToString("0.0")</span>
    </div>

    <div class="summary-right">
        <div class="count">
            @Count review@(Count == 1 ? "" : "s")
        </div>

        @if (Count > 0)
        {
            <button type="button"
                    class="link-btn"
                    @onclick="GoToAllReviews">
                See all reviews ↓
            </button>
        }
    </div>
</div>

@code {
    // ID-ul entității care primește review-uri (ProfileId sau ListingId)
    [Parameter] public Guid TargetId { get; set; }

    // Profile / Listing
    [Parameter] public ReviewTargetType TargetType { get; set; }

    // NECESAR pentru navigarea înapoi corectă
    [Parameter] public Guid OwnerUserId { get; set; }

    private double Average;
    private int Count;

    protected override async Task OnParametersSetAsync()
    {
        await LoadSummary();
    }

    private async Task LoadSummary()
    {
        try
        {
            AuthService.AddAuthorizationHeader(Http);

            var url = TargetType == ReviewTargetType.Profile
                ? $"/profiles/{TargetId}/reviews"
                : $"/listings/{TargetId}/reviews";

            var reviews =
                await Http.GetFromJsonAsync<List<ReviewDto>>(url)
                ?? new List<ReviewDto>();

            Count = reviews.Count;
            Average = Count == 0 ? 0 : reviews.Average(r => r.Rating);
        }
        catch
        {
            Count = 0;
            Average = 0;
        }
    }

    private void GoToAllReviews()
    {
        string route = TargetType switch
        {
            ReviewTargetType.Profile =>
                $"/reviews/profile/{TargetId}/{OwnerUserId}",

            ReviewTargetType.Listing =>
                $"/reviews/listing/{TargetId}",

            _ => "/"
        };

        Navigation.NavigateTo(route);
    }
}
