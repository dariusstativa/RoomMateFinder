@using RoomMateFinder.Client.Models
@inject HttpClient Http
@inject RoomMateFinder.Client.Services.AuthService AuthService

<div class="review-card">
    <div class="review-header">
        <div class="review-author">
            <strong>@Review.ReviewerName</strong>
            <span class="review-rating">
                ⭐ @Review.Rating / 5
            </span>
        </div>

        @if (AuthService.UserId == Review.ReviewerId)
        {
            <button class="btn-delete" @onclick="DeleteReview">
                Delete
            </button>
        }
    </div>

    <p class="review-comment">
        @Review.Comment
    </p>

    <div class="review-footer">
        @Review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
    </div>
</div>

@code {
    [Parameter] public ReviewDto Review { get; set; } = default!;
    [Parameter] public EventCallback OnDeleted { get; set; }

    private async Task DeleteReview()
    {
        AuthService.AddAuthorizationHeader(Http);
        await Http.DeleteAsync($"/reviews/{Review.Id}");
        await OnDeleted.InvokeAsync();
    }
}