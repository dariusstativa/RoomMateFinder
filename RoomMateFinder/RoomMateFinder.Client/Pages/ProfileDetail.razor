@page "/profiles/{userId:guid}"
@page "/my-profile"
@using System.Text.Encodings.Web
@using RoomMateFinder.Client.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject RoomMateFinder.Client.Services.AuthService AuthService

<div class="profile-v2-page">
    @if (isLoading)
    {
        <div class="loading">Loading profile...</div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-container">@errorMessage</div>
    }
    else if (profile != null)
    {
        <div class="profile-v2-card">

            <!-- LEFT SUMMARY -->
            <aside class="profile-left">
                <div class="avatar-circle">
                    @GetInitials(profile.FullName)
                </div>

                <h1>@profile.FullName</h1>
                <p class="meta">@profile.Age years • @profile.Gender</p>
                <p class="university">🎓 @profile.University</p>

                @if (profile.UserId == AuthService.UserId)
                {
                    <button class="btn-primary"
                            @onclick="@(() => Navigation.NavigateTo("/profile/edit"))">
                        Edit Profile
                    </button>
                }
                else
                {
                    <button class="btn-secondary"
                            @onclick="@(() => Navigation.NavigateTo("/profiles"))">
                        ← Back
                    </button>
                }
            </aside>

            <!-- RIGHT CONTENT -->
            <section class="profile-right">

                <div class="info-card">
                    <h3>📝 About Me</h3>
                    <p>@profile.Bio</p>
                </div>

                <div class="info-card">
                    <h3>🏠 Living Preferences</h3>
                    <ul>
                        <li><strong>Sleep:</strong> @profile.SleepSchedule</li>
                        <li><strong>Cleanliness:</strong> @profile.Cleanliness</li>
                        <li><strong>Noise:</strong> @profile.NoiseTolerance</li>
                    </ul>
                </div>

                <div class="info-card">
                    <h3>🚭 Lifestyle</h3>
                    <ul>
                        <li><strong>Smoking:</strong> @profile.SmokingPreference</li>
                        <li><strong>Pets:</strong> @profile.PetPreference</li>
                    </ul>
                </div>

                <div class="info-card">
                    <h3>📚 Study Habits</h3>
                    <p>@profile.StudyHabits</p>
                </div>

                @if (profile.UserId != AuthService.UserId)
                {
                    <div class="info-card actions">
                        <button class="btn-like" @onclick="HandleLike">👍 Like</button>
                        <button class="btn-dislike" @onclick="HandleDislike">👎 Pass</button>
                        <button class="btn-message" @onclick="OpenChat">
                            💬 Message
                        </button>
                    </div>
                }

                <!-- ⭐ REVIEW SUMMARY -->
                <div class="info-card">
                    <ReviewSummary
                        TargetId="profile.Id"
                        TargetType="ReviewTargetType.Profile" />
                </div>

                <!-- ⭐ REVIEWS LIST -->
                <ReviewList
                    @key="profile.Id"
                    TargetId="profile.Id"
                    TargetType="ReviewTargetType.Profile"
                    OwnerUserId="profile.UserId" />

            </section>
        </div>
    }
</div>

@code {
    [Parameter] public Guid? UserId { get; set; }

    private Profile? profile;
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (UserId == null)
        {
            if (!AuthService.IsAuthenticated)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            UserId = AuthService.UserId;
        }

        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        try
        {
            AuthService.AddAuthorizationHeader(Http);
            profile = await Http.GetFromJsonAsync<Profile>($"/profiles/{UserId}");
        }
        catch
        {
            errorMessage = "Failed to load profile.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleLike()
    {
        if (profile == null) return;

        AuthService.AddAuthorizationHeader(Http);

        await Http.PostAsJsonAsync("/matching/like", new
        {
            targetProfileId = profile.Id
        });
    }

    private async Task HandleDislike()
    {
        if (profile == null) return;

        AuthService.AddAuthorizationHeader(Http);

        await Http.PostAsJsonAsync("/matching/dislike", new
        {
            targetProfileId = profile.Id
        });
    }

    private async Task OpenChat()
    {
        if (profile == null) return;

        AuthService.AddAuthorizationHeader(Http);

        var resp = await Http.PostAsync($"/conversations/with/{profile.UserId}", content: null);

        if (!resp.IsSuccessStatusCode)
        {
            errorMessage = $"Failed to create/get conversation: {(int)resp.StatusCode} {resp.ReasonPhrase}";
            return;
        }

        var conversationId = await resp.Content.ReadFromJsonAsync<Guid>();

        if (conversationId == Guid.Empty)
        {
            errorMessage = "Conversation id is empty.";
            return;
        }

        Navigation.NavigateTo($"/chat/{conversationId}");
    }

    private string GetInitials(string name)
    {
        var p = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length == 1
            ? p[0][0].ToString().ToUpper()
            : $"{p[0][0]}{p[^1][0]}".ToUpper();
    }
}
