@page "/chat/{conversationId:guid}/{otherUserId:guid}"

@using RoomMateFinder.Client.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.SignalR.Client
@using RoomMateFinder.Client.Services

@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation
@inject RoomMateFinder.Client.Services.AuthService AuthService
@inject IJSRuntime JS

<div class="chat-page">
    <div class="chat-header">
        <button class="chat-back-btn"
                @onclick="@(() => Navigation.NavigateTo("/matches"))"
                aria-label="Back to matches">
            <span class="chat-back-icon">←</span>
            <span class="chat-back-text">Back</span>
        </button>

        <h2>Chat</h2>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="chat-error">@error</div>
    }

    <div class="chat-messages" @ref="messagesDiv">
        @foreach (var msg in messages)
        {
            <div class="chat-bubble @(msg.SenderId == AuthService.UserId ? "sent" : "received")">
                <div class="chat-text">@msg.Content</div>
                <div class="chat-time">
                    @msg.SentAt.ToLocalTime().ToShortTimeString()
                </div>
            </div>
        }
    </div>

    <div class="chat-input">
        <input type="text"
               placeholder="Type a message..."
               @bind="newMessage"
               @onkeydown="HandleKey" />

        <button @onclick="SendMessage">Send</button>
    </div>
</div>

@code {
    [Parameter] public Guid conversationId { get; set; }
    [Parameter] public Guid otherUserId { get; set; }

    private List<MessageResponse> messages = new();
    private string newMessage = string.Empty;
    private string? error;
    private ElementReference messagesDiv;
    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadMessages();
        await ConnectToSignalR();
        await ScrollToBottom();
    }

    private async Task LoadMessages()
    {
        try
        {
            var http = ClientFactory.CreateClient("RoomMateFinderAPI");

            messages = await http.GetFromJsonAsync<List<MessageResponse>>(
                $"/messages/conversation/{conversationId}"
            ) ?? new();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task ConnectToSignalR()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl("http://localhost:5044/hubs/chat", options =>
            {
                options.AccessTokenProvider = () =>
                    Task.FromResult(AuthService.Token)!;
            })
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<MessageResponse>("ReceiveMessage", msg =>
        {
            messages.Add(msg);
            InvokeAsync(StateHasChanged);
            InvokeAsync(ScrollToBottom);
        });

        await hubConnection.StartAsync();
        await hubConnection.InvokeAsync("JoinConversation", conversationId);
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessage))
            return;

        var http = ClientFactory.CreateClient("RoomMateFinderAPI");

        await http.PostAsJsonAsync("/messages/send", new
        {
            ConversationId = conversationId,
            Content = newMessage
        });

        newMessage = string.Empty;
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            _ = SendMessage();
    }

    private async Task ScrollToBottom()
    {
        await messagesDiv.ScrollToEndAsync(JS);
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
            await hubConnection.DisposeAsync();
    }
}
