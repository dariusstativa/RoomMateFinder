@page "/listings/{id:guid}"

@inject HttpClient Http
@inject NavigationManager Navigation
@inject RoomMateFinder.Client.Services.AuthService AuthService
@inject IJSRuntime JSRuntime

<div class="listing-page">

    @if (isLoading)
    {
        <div class="loading">Loading listing details...</div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-container">
            <p>@errorMessage</p>
            <button class="listing-back-btn"
                    @onclick="@(() => Navigation.NavigateTo("/listings"))">
                ← Back to Listings
            </button>
        </div>
    }
    else if (listing != null)
    {
        <div class="listing-card">

            <!-- HEADER -->
            <div class="listing-header">
                <button class="listing-back-btn"
                        @onclick="@(() => Navigation.NavigateTo("/listings"))">
                    ← Back to Listings
                </button>

                @if (listing.OwnerId == AuthService.UserId)
                {
                    <div class="owner-actions">
                        <button class="btn-secondary"
                                @onclick="@(() => Navigation.NavigateTo($"/listings/{Id}/edit"))">
                            Edit
                        </button>

                        <button class="btn-danger" @onclick="HandleDelete">
                            Delete
                        </button>
                    </div>
                }
            </div>

            <!-- TITLE -->
            <h1 class="listing-title">@listing.Title</h1>

            <div class="listing-meta">
                <span class="price">$@listing.Price / month</span>
                <span>• Posted @FormatDate(listing.CreatedAt)</span>
            </div>

            <!-- INFO GRID -->
            <div class="listing-info-grid">
                <div class="info-card">
                    <h3>📍 Location</h3>
                    <p>@listing.Address</p>
                </div>

                <div class="info-card">
                    <h3>📝 Description</h3>
                    <p>@listing.Description</p>
                </div>

                <div class="info-card">
                    <h3>👥 Roommates</h3>
                    <p>@listing.RoommatesCount</p>
                </div>

                <div class="info-card">
                    <h3>🚻 Gender Preference</h3>
                    <p>@listing.GenderPreference</p>
                </div>
            </div>

            <!-- CONTACT -->
            @if (listing.OwnerId != AuthService.UserId)
            {
                <div class="contact-card">
                    <h3>💬 Interested?</h3>
                    <p>Contact the owner to learn more about this listing.</p>

                    <button class="btn-primary"
                            disabled="@isMessaging"
                            @onclick="HandleMessage">
                        @(isMessaging ? "Opening chat..." : "Send Message")
                    </button>
                </div>
            }

            <!-- REVIEWS -->
            <div class="listing-reviews">
                <ReviewList TargetId="listing.Id"
                            TargetType="ReviewTargetType.Listing"
                            OwnerUserId="listing.OwnerId" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private RoomListing? listing;
    private string errorMessage = string.Empty;
    private bool isLoading = true;
    private bool isMessaging = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadListing();
    }

    private async Task LoadListing()
    {
        try
        {
            AuthService.AddAuthorizationHeader(Http);
            listing = await Http.GetFromJsonAsync<RoomListing>($"/listings/{Id}");
        }
        catch
        {
            errorMessage = "Failed to load listing.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleDelete()
    {
        if (!await JSRuntime.InvokeAsync<bool>(
                "confirm", "Are you sure you want to delete this listing?"))
            return;

        AuthService.AddAuthorizationHeader(Http);

        var response = await Http.DeleteAsync($"/listings/{Id}");

        if (response.IsSuccessStatusCode)
            Navigation.NavigateTo("/my-listings");
        else
            errorMessage = "Failed to delete listing.";
    }

    private async Task HandleMessage()
    {
        if (listing is null)
            return;

        isMessaging = true;

        try
        {
            AuthService.AddAuthorizationHeader(Http);

            var response = await Http.PostAsync(
                $"/conversations/listing/{listing.Id}",
                content: null
            );

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Failed to open conversation.";
                return;
            }

            var conversationId =
                await response.Content.ReadFromJsonAsync<Guid>();

            // ✅ FIX: Navigate with BOTH conversationId AND otherUserId (the listing owner)
            Navigation.NavigateTo($"/chat/{conversationId}/{listing.OwnerId}");
        }
        catch
        {
            errorMessage = "Failed to open conversation.";
        }
        finally
        {
            isMessaging = false;
        }
    }

    private static string FormatDate(DateTime date)
    {
        var span = DateTime.UtcNow - date;

        if (span.TotalDays < 1) return "today";
        if (span.TotalDays < 2) return "yesterday";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays} days ago";
        return date.ToString("MMM dd, yyyy");
    }
}