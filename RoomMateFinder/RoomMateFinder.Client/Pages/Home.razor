@page "/"
@using Microsoft.AspNetCore.Components.Routing
<div class="page-bleed">
    <div class="hero">
        <div class="hero-overlay"></div>

        <div class="hero-content">
            <div class="hero-left">
                <h1 class="hero-title">Find your perfect roommate</h1>
                <p class="hero-subtitle">
                    Discover compatible roommates, chat in real time, and find the perfect place to live.
                </p>

                <div class="hero-actions">
                    <NavLink class="hero-btn hero-btn-primary" href="/profiles" Match="NavLinkMatch.Prefix">
                        Find Roommates
                    </NavLink>

                    <NavLink class="hero-btn hero-btn-ghost" href="/listings" Match="NavLinkMatch.Prefix">
                        Browse Rooms
                    </NavLink>
                </div>
            </div>

            <div class="hero-right">
                <div class="hero-card">
                    <div class="hero-card-title">Quick Start</div>
                    <div class="hero-card-text">Complete your profile for better matches.</div>

                    <NavLink class="hero-btn hero-btn-light" href="/my-profile" Match="NavLinkMatch.Prefix">
                        Go to My Profile
                    </NavLink>
                </div>
            </div>
        </div>
    </div>
</div>


@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            Console.WriteLine("HOME: OnInitializedAsync start");
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine("HOME INIT ERROR: " + ex);
            throw;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                Console.WriteLine("HOME: OnAfterRender firstRender");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine("HOME RENDER ERROR: " + ex);
            throw;
        }
    }
}
