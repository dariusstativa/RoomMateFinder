@using RoomMateFinder.Client.Models
@using System.Net.Http.Json

@inject HttpClient Http
@inject RoomMateFinder.Client.Services.AuthService AuthService

<div id="reviews-section" class="reviews-imdb">

    <h3 class="reviews-title">
        Reviews
        <span class="count">(@reviews.Count)</span>
    </h3>

    @if (isLoading)
    {
        <p>Loading reviews...</p>
    }
    else if (!reviews.Any())
    {
        <p class="no-reviews">No reviews yet.</p>
    }
    else
    {
        @foreach (var review in reviews.Take(3))
        {
            <div class="review-row">
                <div class="review-top">
                    <strong>@review.ReviewerName</strong>
                    <span class="stars">@RenderStars(review.Rating)</span>
                </div>

                <p class="comment">@review.Comment</p>

                <div class="review-bottom">
                    <span class="date">
                        @review.CreatedAt.ToLocalTime().ToShortDateString()
                    </span>

                    @if (AuthService.UserId == review.ReviewerId)
                    {
                        <button class="link-danger"
                                @onclick="() => DeleteReview(review.Id)">
                            Delete
                        </button>
                    }
                </div>
            </div>
        }

        @if (reviews.Count > 3)
        {
            <p class="more-reviews">
                Showing latest 3 of @reviews.Count reviews
            </p>
        }
    }

    @if (CanAddReview)
    {
        <div class="add-review-box">
            <AddReviewForm TargetId="TargetId"
                           TargetType="TargetType"
                           OnAdded="HandleReviewAdded" />
        </div>
    }
</div>

@code {
   

    [Parameter] public Guid TargetId { get; set; }
    [Parameter] public ReviewTargetType TargetType { get; set; }
    [Parameter] public Guid OwnerUserId { get; set; }

    
    [Parameter] public EventCallback ReviewsChanged { get; set; }

   

    private List<ReviewDto> reviews = new();
    private bool isLoading;

    private bool CanAddReview =>
        AuthService.IsAuthenticated &&
        OwnerUserId != Guid.Empty &&
        AuthService.UserId != OwnerUserId;

   

    protected override async Task OnParametersSetAsync()
    {
        await ReloadReviews();
    }

   

    private async Task ReloadReviews()
    {
        isLoading = true;

        try
        {
            AuthService.AddAuthorizationHeader(Http);

            var url = TargetType == ReviewTargetType.Profile
                ? $"/profiles/{TargetId}/reviews"
                : $"/listings/{TargetId}/reviews";

            reviews = await Http.GetFromJsonAsync<List<ReviewDto>>(url)
                      ?? new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteReview(Guid id)
    {
        AuthService.AddAuthorizationHeader(Http);

        await Http.DeleteAsync($"/reviews/{id}");

        await ReloadReviews();

        
        await ReviewsChanged.InvokeAsync();
    }

    private async Task HandleReviewAdded()
    {
        await ReloadReviews();

        
        await ReviewsChanged.InvokeAsync();
    }

    private static string RenderStars(int rating)
        => new string('⭐', rating);
}
