@page "/matches"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject RoomMateFinder.Client.Services.AuthService AuthService

<div class="matches-container">
    <div class="matches-header">
        <h1>🎉 Your Matches</h1>
        <p class="subtitle">People who liked you back!</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-message">@errorMessage</div>
    }

    @if (isLoading)
    {
        <div class="loading">Loading matches...</div>
    }
    else if (matches == null || !matches.Any())
    {
        <div class="no-matches">
            <div class="empty-state">
                <span class="icon">💔</span>
                <h2>No matches yet</h2>
                <p>Start liking profiles to find your perfect roommate!</p>
                <button class="btn-browse" @onclick="@(() => Navigation.NavigateTo("/profiles"))">
                    Browse Profiles
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="matches-count">
            <p>You have <strong>@matches.Count</strong> match@(matches.Count != 1 ? "es" : "")! 🎊</p>
        </div>

        <div class="matches-grid">
            @foreach (var profile in matches)
            {
                <div class="match-card"
                     @onclick="@(() => Navigation.NavigateTo($"/profiles/{profile.UserId}"))">

                    <div class="match-badge">✨ Match!</div>

                    <div class="profile-header">
                        <div class="avatar">@GetInitials(profile.FullName)</div>
                        <div class="profile-info">
                            <h3>@profile.FullName</h3>
                            <p class="meta">@profile.Age years • @profile.Gender</p>
                        </div>
                    </div>

                    <div class="profile-details">
                        <p class="university">🎓 @profile.University</p>
                        <p class="bio">
                            @(profile.Bio?.Length > 120
                                ? profile.Bio.Substring(0, 120) + "..."
                                : profile.Bio)
                        </p>
                    </div>

                    <div class="profile-tags">
                        <span class="tag">🌙 @profile.SleepSchedule</span>
                        <span class="tag">✨ @profile.Cleanliness</span>
                        <span class="tag">🔊 @profile.NoiseTolerance</span>
                    </div>

                    <div class="match-footer">
                        <button class="btn-view"
                                @onclick:stopPropagation="true"
                                @onclick="@(() => Navigation.NavigateTo($"/profiles/{profile.UserId}"))">
                            View Profile
                        </button>

                        <button class="btn-message"
                                @onclick:stopPropagation="true"
                                @onclick="() => OpenChat(profile)">
                            💬 Message
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Profile>? matches;
    private string errorMessage = string.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadMatches();
    }

    private async Task LoadMatches()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            AuthService.AddAuthorizationHeader(Http);

            var response = await Http.GetAsync("/matches");

            if (response.IsSuccessStatusCode)
            {
                matches = await response.Content.ReadFromJsonAsync<List<Profile>>();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                matches = new List<Profile>();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to load matches: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading matches: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenChat(Profile profile)
    {
        AuthService.AddAuthorizationHeader(Http);

        var resp = await Http.PostAsync(
            $"/conversations/with/{profile.UserId}",
            content: null);

        if (!resp.IsSuccessStatusCode)
        {
            errorMessage = "Failed to open chat.";
            return;
        }

        var conversationId = await resp.Content.ReadFromJsonAsync<Guid>();

        if (conversationId == Guid.Empty)
        {
            errorMessage = "Invalid conversation id.";
            return;
        }

        // ✅ OBLIGATORIU ambii parametri
        Navigation.NavigateTo($"/chat/{conversationId}/{profile.UserId}");
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "?";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][0].ToString().ToUpper()
            : $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }
}


<style>
    .matches-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 40px 20px;
    }

    .matches-header {
        max-width: 1200px;
        margin: 0 auto 40px;
        text-align: center;
        color: white;
    }

    h1 {
        font-size: 42px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .subtitle {
        font-size: 20px;
        opacity: 0.95;
    }

    .matches-count {
        max-width: 1200px;
        margin: 0 auto 30px;
        text-align: center;
        background: white;
        padding: 20px;
        border-radius: 12px;
    }

    .matches-grid {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 24px;
    }

    .match-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        cursor: pointer;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        position: relative;
    }

    .match-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.2);
    }

    .match-badge {
        position: absolute;
        top: 16px;
        right: 16px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .profile-header {
        display: flex;
        gap: 16px;
        margin-bottom: 16px;
    }

    .avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        font-size: 24px;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .profile-tags {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .tag {
        background: #f0f4ff;
        color: #667eea;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
    }

    .match-footer {
        display: flex;
        gap: 12px;
        border-top: 1px solid #eee;
        padding-top: 16px;
    }

    .btn-view, .btn-message {
        flex: 1;
        padding: 10px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-view {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }

    .btn-message {
        background: #f0f4ff;
        color: #667eea;
    }
</style>
