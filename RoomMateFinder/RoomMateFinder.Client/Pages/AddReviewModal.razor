@using RoomMateFinder.Client.Models
@inject HttpClient Http
@inject RoomMateFinder.Client.Services.AuthService AuthService

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-card" @onclick:stopPropagation="true">

            <h3>Leave a review</h3>

            <div class="stars">
                @for (int i = 1; i <= 5; i++)
                {
                    <span class="star @(rating >= i ? "active" : "")"
                          @onclick="@(() => rating = i)">
                        ⭐
                    </span>
                }
            </div>

            <textarea placeholder="Write your review..."
                      @bind="comment"></textarea>

            <div class="modal-actions">
                <button class="btn-secondary" @onclick="Close">
                    Cancel
                </button>
                <button class="btn-primary"
                        disabled="@(!CanSubmit)"
                        @onclick="Submit">
                    Submit
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid TargetId { get; set; }
    [Parameter] public ReviewTargetType TargetType { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnAdded { get; set; }

    private int rating = 0;
    private string comment = "";

    private bool CanSubmit => rating > 0 && comment.Length >= 5;

    private async Task Submit()
    {
        AuthService.AddAuthorizationHeader(Http);

        var url = TargetType == ReviewTargetType.Profile
            ? $"/profiles/{TargetId}/reviews"
            : $"/listings/{TargetId}/reviews";

        await Http.PostAsJsonAsync(url, new
        {
            Rating = rating,
            Comment = comment
        });

        rating = 0;
        comment = "";

        await OnAdded.InvokeAsync();
        await OnClose.InvokeAsync();
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
